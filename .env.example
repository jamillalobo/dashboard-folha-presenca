# Copie para .env e preencha. Aceita link completo ou só o ID.
# Reinicie o streamlit depois de alterar o .env.

# Pastas com subpastas images/ e labels/ (GT), separadas por vírgula
GT_FOLDERS=https://drive.google.com/drive/folders/<ID_LOTE_1>,https://drive.google.com/drive/folders/<ID_LOTE_2>

# Pasta com as pastas de predições dos modelos
PREDICTIONS_FOLDER=https://drive.google.com/drive/folders/<ID>

# Planilha consolidada de métricas
METRICS_SHEET=https://docs.google.com/spreadsheets/d/<ID>/edit
